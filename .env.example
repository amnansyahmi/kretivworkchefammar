# Postgres connection string. Leave unset and the app keeps working
# exactly as today (approvals/payments/campaign reset on refresh).
# Set it (Vercel Postgres, Neon, Supabase — any Postgres provider) to
# persist commission approve/pay state and the scheduled campaign.
# Run `npx drizzle-kit push --config=drizzle.postgres.config.ts` once
# set to create the tables.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Data source toggles — "mock" or "real" (default: mock if unset)
# Set to "real" per platform once that platform's API integration is
# implemented in lib/sources/{bcl,shopee,tiktok}.ts.
DATA_SOURCE_BCLMY=mock
DATA_SOURCE_SHOPEE=mock
DATA_SOURCE_TIKTOK=mock

# Courier/logistics toggles — "mock" or "real" (default: mock if unset).
# EasyParcel is the recommended route: it's a Malaysian aggregator whose
# single self-serve API key books and tracks J&T Express, Pos Laju,
# Ninja Van and DHL eCommerce. Implement fetchReal() in
# lib/logistics/{easyparcel,jnt}.ts before flipping these to "real".
DATA_SOURCE_EASYPARCEL=mock
DATA_SOURCE_JNT=mock

# --- Below: not wired up yet. Fill in once each platform's fetchReal()
# is implemented and you have the corresponding API credentials. ---

# EasyParcel (app.easyparcel.com > Integrations > API key).
# Production host: https://connect.easyparcel.my
# Sandbox host:    http://demo.connect.easyparcel.my
# EASYPARCEL_API_KEY=

# J&T Express direct — merchant contract only; J&T Malaysia has no public
# self-serve API. Your J&T account manager issues the customer code, the
# private key used to sign requests, and the gateway host assigned to you.
# Most merchants should use EasyParcel above instead.
# JNT_API_BASE_URL=
# JNT_CUSTOMER_CODE=
# JNT_PRIVATE_KEY=

# Shopee Open Platform (open.shopee.com)
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_SHOP_ID=
# SHOPEE_ACCESS_TOKEN=
# SHOPEE_REFRESH_TOKEN=

# TikTok Shop Partner Center (partner.tiktokshop.com)
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# TIKTOK_SHOP_ID=
# TIKTOK_ACCESS_TOKEN=

# BCL.my (confirm exact fields once their API docs are available)
# BCLMY_API_KEY=
